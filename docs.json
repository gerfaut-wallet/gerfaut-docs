{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Gerfaut",
  "colors": {
    "primary": "#0E7490",
    "light": "#7DD3E8",
    "dark": "#0A5D75"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://gerfaut-wallet.com"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "body": {
      "family": "Instrument Sans",
      "source": "https://gerfaut-wallet.com/fonts/instrument-sans/InstrumentSans-Variable.woff2",
      "format": "woff2",
      "weight": 400
    },
    "heading": {
      "family": "Bricolage Grotesque",
      "source": "https://gerfaut-wallet.com/fonts/bricolage-grotesque/BricolageGrotesque-Variable.woff2",
      "format": "woff2",
      "weight": 700
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B0F14"
    }
  },
