        "icon": "book-open",
        "groups": [
          {
            "group": "Home",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Getting started",
            "pages": [
              "getting-started/what-is-gerfaut",
              "getting-started/install-desktop",
              "getting-started/install-android",
              "getting-started/verify-your-download"
            ]
          },
          {
            "group": "Using Gerfaut",
            "pages": [
              {
                "group": "Wallets",
                "icon": "wallet",
                "expanded": false,
                "pages": [
                  "wallets/overview",
                  "wallets/add-a-wallet",
                  "wallets/wallet-types",
                  "wallets/watch-an-address",
                  "wallets/policy-and-timelocks"
                ]
              },
              {
                "group": "Everyday use",
                "icon": "activity",
                "expanded": false,
                "pages": [
                  "everyday-use/overview",
                  "everyday-use/balances-and-history",
                  "everyday-use/transaction-details",
                  "everyday-use/utxos",
                  "everyday-use/receive-addresses",
                  "everyday-use/broadcast-a-transaction"
                ]
              },
              {
                "group": "Settings",
                "icon": "settings",
                "expanded": false,
                "pages": [
                  "settings/overview",
                  "settings/backends-and-your-own-node",
                  "settings/certificates",
                  "settings/tor",
                  "settings/units-and-fiat",
                  "settings/appearance",
                  "settings/app-lock",
                  "settings/backup-and-sync",
                  "settings/notifications"
                ]
              },
              {
                "group": "Premium",
                "icon": "gem",
                "expanded": false,
                "pages": [
                  "premium/overview",
                  "premium/get-a-key",
                  "premium/watch-a-wallet",
                  "premium/channels",
                  "premium/limits",
                  "premium/delete-your-data"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "menu": [
          {
            "item": "Desktop",
            "icon": "monitor",
            "description": "Windows, macOS and Linux.",
            "pages": [
              "changelog/desktop"
            ]
          },
          {
            "item": "Android",
            "icon": "smartphone",
            "description": "The Android app.",
            "pages": [
              "changelog/android"
            ]
          }
        ]
      },
      {
        "tab": "Help",
        "icon": "life-buoy",
        "menu": [
          {
            "item": "FAQ",
            "icon": "circle-question-mark",
            "description": "Short answers to the questions people ask most.",
            "pages": [
              "help/faq"
            ]
          },
          {
            "item": "Contact",
            "icon": "mail",
            "description": "A question, a bug or a security report.",
            "pages": [
              "help/contact"
            ]
          }
        ]
      }
